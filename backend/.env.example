# =============================================================================
# AutoLaw Backend Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
#   cp backend/.env.example backend/.env
# =============================================================================

# --- App ---
# Application name (optional, default: "AutoLaw API")
# AUTOLAW_APP_NAME="AutoLaw API"

# Enable debug mode (optional, default: false)
# AUTOLAW_DEBUG=false

# --- Database ---
# SQLAlchemy database URL (optional, default: sqlite+aiosqlite:///./uploads/autolaw.db)
# For PostgreSQL in production:
#   AUTOLAW_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/autolaw
# AUTOLAW_DATABASE_URL="sqlite+aiosqlite:///./uploads/autolaw.db"

# --- File Storage ---
# Storage provider: "local" (default) or "s3"
# AUTOLAW_STORAGE_PROVIDER="local"

# Directory for uploaded files (optional, auto-generated relative path)
# AUTOLAW_UPLOAD_DIR=<auto-generated>

# Max file size per upload in MB (optional, default: 50)
# AUTOLAW_MAX_FILE_SIZE_MB=50

# Max total storage per matter in MB (optional, default: 500)
# AUTOLAW_MAX_MATTER_TOTAL_MB=500

# --- S3-compatible Storage (used when STORAGE_PROVIDER="s3") ---
# Works with AWS S3 (leave endpoint empty), Cloudflare R2, MinIO, etc.
# AUTOLAW_S3_ENDPOINT_URL=""
# AUTOLAW_S3_REGION="us-east-1"
# AUTOLAW_S3_ACCESS_KEY_ID=""
# AUTOLAW_S3_SECRET_ACCESS_KEY=""
# AUTOLAW_S3_BUCKET_NAME=""

# --- OCR ---
# Path to the Tesseract OCR binary (optional, default: /opt/homebrew/bin/tesseract)
# AUTOLAW_TESSERACT_CMD="/opt/homebrew/bin/tesseract"

# --- LLM / OpenRouter (optional — enables AI event extraction) ---
# OpenRouter API key (required for LLM-powered event extraction; omit to use pattern-based fallback)
# Get your key at: https://openrouter.ai/keys
# AUTOLAW_OPENROUTER_API_KEY="sk-or-v1-..."

# Model slug on OpenRouter (optional, default: "openai/gpt-4o-mini")
# Examples: "anthropic/claude-3-5-haiku", "deepseek/deepseek-chat", "google/gemini-2.0-flash-001"
# AUTOLAW_LLM_MODEL="openai/gpt-4o-mini"

# Base URL for the OpenAI-compatible API (optional, default: "https://openrouter.ai/api/v1")
# Change this to use a different provider (e.g., a local vLLM instance).
# AUTOLAW_LLM_BASE_URL="https://openrouter.ai/api/v1"

# --- Email Ingestion (placeholder — Phase 2) ---
# Domain used for per-matter email addresses (optional, default: "matter.autolaw.app")
# AUTOLAW_EMAIL_DOMAIN="matter.autolaw.app"
